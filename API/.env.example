# MediaForge local development configuration.
# Copy to API/.env (the setup script does this automatically when absent).
# Do not commit API/.env: it may contain real provider credentials.

TZ=Asia/Shanghai

# Native local development infrastructure.
POSTGRES_USER=mediaforge
POSTGRES_PASSWORD=mediaforge_dev_password
POSTGRES_DB=mediaforge
DATABASE_URL=postgresql://mediaforge:mediaforge_dev_password@127.0.0.1:5432/mediaforge

REDIS_URL=redis://127.0.0.1:6379/0

# Canvas Agent event outbox reconciliation. A stale tool-progress group is
# force-closed after the timeout; scanning runs at the configured interval.
AGENT_EVENT_TOOL_GROUP_TIMEOUT_SECONDS=300
AGENT_EVENT_TOOL_GROUP_SCAN_SECONDS=15

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=mediaforge_dev_password
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=mediaforge_dev_password
MINIO_SECURE=false

# Keep local PostgreSQL, Redis, and MinIO out of a workstation-wide proxy.
NO_PROXY=127.0.0.1,localhost
no_proxy=127.0.0.1,localhost

# Add provider credentials as needed. Leaving these blank keeps the app usable
# for local UI and infrastructure development.
COMFLY_API_KEY=
MODELSCOPE_API_KEY=
RUNNINGHUB_API_KEY=
COMFYUI_INSTANCES=127.0.0.1:8188
